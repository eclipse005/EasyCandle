{
  "name": "bar-replay",
  "version": "0.1.5",
  "description": "BarReplay — candle replay web app (pure frontend port)",
  "private": true,
  "author": "BarReplay",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://barreplay.pages.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/eclipse005/BarReplay.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --port 3000 --host",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && wrangler deploy",
    "cf:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "driver.js": "^1.8.0",
    "lightweight-charts": "^5.2.0",
    "lightweight-charts-drawing": "^0.6.2",
    "lucide-react": "^1.25.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^3.2.4",
    "wrangler": "^4.86.0"
  }
}
